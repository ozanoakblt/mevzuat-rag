# Groq API key (generation için, Faz 8'de kullanılacak; Faz 3'te senaryo
# etiketleme için de kullanılıyor). Ücretsiz: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Reranker modeli (Faz 7). Değiştirmek isterseniz .env'e ekleyin.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# İndirme sırasında gönderilecek User-Agent (kaynaklara karşı şeffaf olmak için)
INGEST_USER_AGENT="mevzuat-rag-internal-tool/0.1 (sirket ici kullanim; iletisim: <email-buraya>)"

# İstekler arası minimum bekleme (saniye) — kaynak sunucuları yormamak için
INGEST_REQUEST_DELAY_SECONDS=3
